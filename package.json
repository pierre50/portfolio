{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,scss}\"",
    "build": "pnpm run format && vue-tsc -b && vite build",
    "deploy": "pnpm run build && touch dist/.nojekyll && gh-pages -d dist -b master -r git@github.com:pierre50/pierre50.github.io.git",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "html2pdf.js": "^0.12.1",
    "marked": "^17.0.5",
    "pdfjs-dist": "^5.6.205",
    "vue": "^3.5.31",
    "vue-i18n": "^11.3.0",
    "vue-pdf-embed": "^2.1.4",
    "vue-router": "^5.0.4",
    "vuetify": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.3",
    "vue-tsc": "^3.2.6"
  }
}
